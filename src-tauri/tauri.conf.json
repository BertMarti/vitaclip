{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitaclip",
  "version": "0.2.1",
  "identifier": "com.bertmarti.vitaclip",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Vitaclip",
        "url": "index.html",
        "width": 380,
        "height": 480,
        "minWidth": 300,
        "minHeight": 320,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "El portapapeles supervitaminado",
    "longDescription": "Historial del portapapeles, fragmentos, transformaciones de texto, capturas de pantalla con anotaciones y grabación de vídeo en una ventanita que se abre con el atajo que elijas.",
    "copyright": "© 2026 BertMarti",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0t64 | libpipewire-0.3-0"
        ]
      }
    }
  }
}
