{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitaclip",
  "version": "1.0.0",
  "identifier": "com.bertmarti.vitaclip",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Vitaclip",
        "url": "index.html",
        "width": 380,
        "height": 480,
        "minWidth": 300,
        "minHeight": 320,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "El portapapeles supervitaminado",
    "longDescription": "Historial del portapapeles, fragmentos, transformaciones de texto, capturas de pantalla con anotaciones y grabación de vídeo en una ventanita que se abre con el atajo que elijas.",
    "copyright": "© 2026 BertMarti",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0t64 | libpipewire-0.3-0"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "instalador/dmg-fondo.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "publisher": "BertMarti",
    "homepage": "https://github.com/BertMarti/vitaclip",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "instalador/nsis-cabecera.bmp",
        "sidebarImage": "instalador/nsis-lateral.bmp",
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "instalador/wix-banda.bmp",
        "dialogImagePath": "instalador/wix-dialogo.bmp",
        "language": [
          "es-ES",
          "en-US"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MzlCODcwNzIyODgwOEYKUldTUGdDaHljTGc1eHEyVU1sYUpVNExVdFhId0xUSXQwcEc4bm5lVDh2U0dkSXhRc1BhMlZianIK",
      "endpoints": [
        "https://github.com/BertMarti/vitaclip/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
