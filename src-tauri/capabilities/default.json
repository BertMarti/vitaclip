{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lo mínimo para las ventanas de Vitaclip: eventos, ocultar, cerrar y enfocar (mover y redimensionar lo hace Rust).",
  "windows": [
    "popup",
    "ajustes",
    "captura",
    "grabacion"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}
